# local | prod
APP_ENV=local

# prod only: contact address of the Let's Encrypt account (optional)
ACME_EMAIL=

# prod only: domain of the wildcard certificate (*.example.com and example.com)
ACME_DOMAIN=

# prod only: DNS provider of that domain, which proves it to Let's Encrypt
# (ovh, cloudflare, gandiv5; others: see make cert@dns)
ACME_DNS_PROVIDER=
